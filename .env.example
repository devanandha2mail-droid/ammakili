# Server Configuration
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/nest_ammakkili

# Security & Sessions
SESSION_SECRET=replace_with_a_long_random_session_secret_for_production
CSRF_SECRET=replace_with_32_char_random_csrf_secret_for_production!

# Razorpay Payments (Set PAYMENTS_MODE to "test" for rzp_test_ or "live" for rzp_live_)
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=rzp_test_placeholderKeyId
RAZORPAY_KEY_SECRET=rzp_test_placeholderKeySecret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_sample

# Cloudinary (Optional - leaves empty to use local storage in public/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth 2.0 (Admin & Customer Sign-in)
GOOGLE_CLIENT_ID=your_google_client_id_from_cloud_console
GOOGLE_CLIENT_SECRET=your_google_client_secret_from_cloud_console
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_ADMIN_CALLBACK_URL=http://localhost:3000/admin/auth/google/callback
REQUIRE_LOGIN_AT_CHECKOUT=false

# Admin Owner Google Account (Allowlisted Owner)
ADMIN_OWNER_EMAIL=owner@example.com

# Business Contact (Without '+' or spaces, with country code, e.g. 91...)
WHATSAPP_NUMBER=919876543210

# Photo Stylist Service
STYLIST_URL=http://stylist:8001
STYLIST_KEY=replace_with_a_long_random_shared_secret_for_stylist


