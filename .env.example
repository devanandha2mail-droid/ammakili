# Server Configuration
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/nest_ammakkili

# Security & Sessions
SESSION_SECRET=replace_with_a_long_random_session_secret_for_production
CSRF_SECRET=replace_with_32_char_random_csrf_secret_for_production!

# Razorpay Payments (Test credentials for dev, change to live in production)
RAZORPAY_KEY_ID=rzp_test_placeholderKeyId
RAZORPAY_KEY_SECRET=rzp_test_placeholderKeySecret
