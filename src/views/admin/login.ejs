<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Login – Nest by Ammakkili</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
  <link rel="stylesheet" href="/css/glass.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body style="min-height:100vh; display:grid; place-items:center; background:linear-gradient(135deg, #fff1f5, #f9dbe5 45%, #f2bfd0); margin:0;">
  <div class="admin-card" style="width:min(420px, 92vw); padding:40px 32px; text-align:center;">
    <div style="margin-bottom:20px; display:inline-block; padding:8px; border-radius:50%; background:rgba(255, 255, 255, 0.9); box-shadow:0 6px 20px rgba(137, 34, 69, 0.15);">
      <picture>
        <source srcset="/img/brand/logo-full-512.webp" type="image/webp">
        <img 
          src="/img/brand/logo-full-128.png" 
          srcset="/img/brand/logo-full-128.png 128w, /img/brand/logo-full-256.png 256w, /img/brand/logo-full-512.png 512w" 
          sizes="108px" 
          width="108" 
          height="108" 
          alt="Nest by Ammakkili logo"
          style="display:block;"
        >
      </picture>
    </div>
    <h2 style="font-size:1.8rem; margin-bottom:8px;">Admin Console</h2>
    <p style="color:var(--admin-muted); font-size:0.9rem; margin-bottom:24px;">Please sign in to manage shop products and orders.</p>

    <% if (error) { %>
      <div style="background:#fee2e2; color:#991b1b; padding:10px; border-radius:8px; font-size:0.85rem; margin-bottom:18px;">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/admin/login" style="text-align:left;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div style="margin-bottom:16px;">
        <label for="email">Admin Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" placeholder="admin@nestammakkili.com">
      </div>

      <div style="margin-bottom:24px;">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••">
      </div>

      <button type="submit" class="btn" style="width:100%;">Sign In</button>
    </form>

    <p style="margin-top:24px; font-size:0.82rem; color:var(--admin-muted);">
      <a href="/" style="text-decoration:underline;">← Return to online store</a>
    </p>
  </div>
</body>
</html>

