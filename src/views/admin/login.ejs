<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Login – Nest by Ammakkili' %></title>
  <!-- Self-hosted Fonts -->
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="icon" type="image/png" href="/img/brand/favicon-32.png">
  <link rel="stylesheet" href="/css/admin-dark.css">
</head>
<body class="admin" style="display:grid; place-items:center; min-height:100vh; padding:20px;">
  <div class="a-card" style="width:min(440px, 94vw); text-align:center;">
    <div style="margin-bottom:20px; display:inline-block; padding:8px; border-radius:50%; background:rgba(255, 255, 255, 0.08); box-shadow:0 0 0 2px rgba(255, 255, 255, 0.8);">
      <picture>
        <source srcset="/img/brand/logo-full-512.webp" type="image/webp">
        <img 
          src="/img/brand/logo-full-128.png" 
          srcset="/img/brand/logo-full-128.png 128w, /img/brand/logo-full-256.png 256w" 
          sizes="96px" 
          width="96" 
          height="96" 
          alt="Nest by Ammakkili logo"
          style="display:block; border-radius:50%;"
        >
      </picture>
    </div>
    <h1 style="font-size:2rem; margin-bottom:6px;">Admin Console</h1>
    <p style="margin-bottom:24px; color:var(--a-muted); line-height:1.5;">
      Sign in with your authorized Google account to manage store inventory and orders.
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="a-alert a-alert--bad" style="text-align:left; margin-bottom:20px;">
        <%= error %>
      </div>
    <% } %>

    <% if (typeof reason !== 'undefined' && reason) { %>
      <div class="a-alert a-alert--warn" style="text-align:left; margin-bottom:20px;">
        <%= reason %>
      </div>
    <% } %>

    <div style="margin:16px 0 24px;">
      <a href="/admin/auth/google" class="a-btn" style="width:100%; display:inline-flex; align-items:center; justify-content:center; gap:12px; padding:12px 20px; font-size:1rem; text-decoration:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        Sign in with Google
      </a>
    </div>

    <% if (typeof process !== 'undefined' && process.env.NODE_ENV !== 'production') { %>
      <div style="margin: -8px 0 16px;">
        <a href="/admin/dev-login" style="font-size: 0.85rem; color: #94a3b8; text-decoration: underline;">
          🛠️ Localhost Developer Bypass: Sign In as Owner
        </a>
      </div>
    <% } %>

    <div style="padding:12px; border-radius:8px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); font-size:0.8rem; color:var(--a-muted); text-align:left; line-height:1.4;">
      <strong style="color:var(--a-fg); display:block; margin-bottom:2px;">Security Notice</strong>
      Access is strictly limited to pre-authorized accounts. Sessions automatically expire after 30 minutes of inactivity. Zero passwords are used or stored.
    </div>

    <p style="margin-top:24px; font-size:0.82rem;">
      <a href="/" class="a-back" style="margin:0;">← Return to online store</a>
    </p>
  </div>
</body>
</html>
