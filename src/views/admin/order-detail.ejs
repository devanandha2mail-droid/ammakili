<div style="margin-bottom:24px;">
  <a href="/admin/orders" class="tlink" style="margin-left:0; font-size:0.8rem;">← Back to Orders</a>
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-top:8px;">
    <div>
      <h1 style="font-size:2rem; margin:0;"><%= order.orderId %></h1>
      <span class="tag-badge status-<%= order.status %>" style="margin-top:6px;"><%= order.status.replace('_', ' ') %></span>
    </div>
    <div style="display:flex; gap:10px;">
      <a href="<%= waLink %>" target="_blank" rel="noopener" class="btn small" style="background:#25D366; border-color:#25D366; color:#fff;">
        💬 Notify on WhatsApp
      </a>
      <a href="/admin/orders/<%= order._id %>/packing-slip" target="_blank" rel="noopener" class="btn small ghost">
        🖨️ Packing Slip
      </a>
    </div>
  </div>
</div>

<div class="two2">
  <!-- Order Items & Customer Details -->
  <div>
    <!-- Items Card -->
    <div class="admin-card">
      <h2 style="font-size:1.3rem; margin-bottom:14px;">Ordered Items</h2>
      <% order.items.forEach(function(item) { %>
        <div class="ln" style="background:transparent; border:0; border-bottom:1px solid var(--admin-border); border-radius:0; padding:12px 0;">
          <img src="<%= item.image || '/img/logo.svg' %>" alt="<%= item.name %>" style="width:56px; height:70px; object-fit:cover; border-radius:6px;">
          <div>
            <strong><%= item.name %></strong>
            <small style="color:var(--admin-muted); display:block;">Size: <strong><%= item.size %></strong> · Qty: <strong><%= item.quantity %></strong></small>
            <small style="color:var(--admin-muted);">Price: ₹<%= item.price.toLocaleString('en-IN') %> each</small>
          </div>
          <div style="text-align:right;">
            <strong>₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></strong>
          </div>
        </div>
      <% }); %>

      <div style="margin-top:16px;">
        <div class="r" style="display:flex; justify-content:space-between; padding:4px 0;">
          <span>Subtotal</span>
          <span>₹<%= order.subtotal.toLocaleString('en-IN') %></span>
        </div>
        <div class="r" style="display:flex; justify-content:space-between; padding:4px 0;">
          <span>Flat Shipping</span>
          <span>₹<%= order.shipping.toLocaleString('en-IN') %></span>
        </div>
        <div class="r" style="display:flex; justify-content:space-between; padding:8px 0; border-top:1px solid var(--admin-border); font-size:1.2rem; font-weight:500;">
          <span>Total Paid</span>
          <span style="color:var(--admin-c1);">₹<%= order.total.toLocaleString('en-IN') %></span>
        </div>
      </div>
    </div>

    <!-- Customer & Delivery Address Card -->
    <div class="admin-card">
      <h2 style="font-size:1.3rem; margin-bottom:12px;">Delivery Destination</h2>
      <p style="margin:0 0 4px; font-size:1.05rem;"><strong><%= order.customer.name %></strong></p>
      <p style="margin:0 0 4px; color:var(--admin-muted);">Phone: <strong><a href="tel:<%= order.customer.phone %>"><%= order.customer.phone %></a></strong></p>
      <% if (order.customer.email) { %>
        <p style="margin:0 0 4px; color:var(--admin-muted);">Email: <%= order.customer.email %></p>
      <% } %>
      <p style="margin:8px 0 0; line-height:1.5;">
        <%= order.customer.address %><br>
        <%= order.customer.city %>, <%= order.customer.state || 'Kerala' %> - <strong><%= order.customer.pin %></strong>
      </p>
    </div>

    <!-- Payment Gateway Diagnostics -->
    <div class="admin-card">
      <h2 style="font-size:1.3rem; margin-bottom:12px;">Payment Details</h2>
      <div style="font-size:0.88rem; color:var(--admin-muted); display:grid; gap:6px;">
        <div>Gateway: <strong><%= order.payment.method || 'Razorpay' %></strong></div>
        <div>Razorpay Order ID: <code><%= order.payment.razorpayOrderId || 'N/A' %></code></div>
        <div>Razorpay Payment ID: <code><%= order.payment.razorpayPaymentId || 'N/A' %></code></div>
        <div>Payment Status: <strong><%= order.payment.status %></strong></div>
      </div>
    </div>
  </div>

  <!-- Status & Tracking Update Form -->
  <div>
    <div class="admin-card" style="position:sticky; top:90px;">
      <h2 style="font-size:1.3rem; margin-bottom:16px;">Fulfillment & Tracking</h2>

      <form method="POST" action="/admin/orders/<%= order._id %>/status">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div style="margin-bottom:16px;">
          <label for="status">Order Status</label>
          <select id="status" name="status" style="font-weight:500;">
            <option value="pending_payment" <%= order.status === 'pending_payment' ? 'selected' : '' %>>pending_payment</option>
            <option value="paid" <%= order.status === 'paid' ? 'selected' : '' %>>paid (Payment Verified)</option>
            <option value="packed" <%= order.status === 'packed' ? 'selected' : '' %>>packed (Ready for Courier)</option>
            <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>shipped (Dispatched)</option>
            <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>delivered (Delivered to Customer)</option>
            <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>cancelled</option>
            <option value="failed" <%= order.status === 'failed' ? 'selected' : '' %>>failed</option>
          </select>
        </div>

        <div style="margin-bottom:16px;">
          <label for="courier">Courier Partner</label>
          <input id="courier" name="courier" value="<%= order.tracking?.courier || '' %>" placeholder="e.g. India Post, ST Courier, DTDC">
        </div>

        <div style="margin-bottom:16px;">
          <label for="trackingId">Tracking ID / Waybill</label>
          <input id="trackingId" name="trackingId" value="<%= order.tracking?.trackingId || '' %>" placeholder="e.g. ST123456789IN">
        </div>

        <div style="margin-bottom:20px;">
          <label for="adminNotes">Private Notes</label>
          <textarea id="adminNotes" name="adminNotes" rows="3" placeholder="Internal remarks, packing checks..."><%= order.adminNotes || '' %></textarea>
        </div>

        <button type="submit" class="btn" style="width:100%;">Update Order</button>
      </form>
    </div>
  </div>
</div>
