<div style="margin-bottom:24px;">
  <a href="/admin/orders" class="a-back">← Back to Orders</a>
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; margin-top:8px;">
    <div>
      <h1 style="font-size:2rem; margin:0; font-family:var(--a-serif); color:var(--a-ink);"><%= order.orderId || order._id %></h1>
      <div style="margin-top:8px;">
        <% 
          let pillClass = 'a-pill';
          const currentStatus = order.status || 'pending_payment';
          if (currentStatus === 'paid' || currentStatus === 'delivered') pillClass += ' a-pill--ok';
          else if (currentStatus === 'packed') pillClass += ' a-pill--info';
          else if (currentStatus === 'shipped') pillClass += ' a-pill--vio';
          else if (currentStatus === 'pending_payment') pillClass += ' a-pill--warn';
          else if (currentStatus === 'cancelled' || currentStatus === 'failed') pillClass += ' a-pill--bad';
          else if (currentStatus === 'refund_needed') pillClass += ' a-pill--bad';
          else if (currentStatus === 'refunded' || currentStatus === 'refund_pending') pillClass += ' a-pill--vio';
        %>
        <% if (currentStatus === 'refund_needed') { %>
          <span class="a-pill" style="background:#fee2e2; color:#991b1b; border:1px solid #f87171; font-weight:700;">⚠️ Refund needed</span>
        <% } else { %>
          <span class="<%= pillClass %>"><%= currentStatus.replace(/_/g, ' ') %></span>
        <% } %>
      </div>
    </div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <% if (typeof waLink !== 'undefined' && waLink && waLink !== '#') { %>
        <a href="<%= waLink %>" target="_blank" rel="noopener" class="a-btn a-btn--sm" style="background:#25D366; border-color:#25D366; color:#fff;">
          💬 Notify on WhatsApp
        </a>
      <% } %>
      <a href="/admin/orders/<%= order._id %>/packing-slip" target="_blank" rel="noopener" class="a-btn a-btn--ghost a-btn--sm">
        🖨️ Packing Slip
      </a>
    </div>
  </div>
</div>

<div class="a-grid-2" style="align-items:start;">
  <!-- Order Items & Customer Details -->
  <div style="display:flex; flex-direction:column; gap:24px;">
    <!-- Items Card -->
    <div class="a-card">
      <h2 style="font-size:1.3rem; margin-bottom:14px; font-family:var(--a-serif); color:var(--a-ink);">Ordered Items</h2>
      <% (order.items || []).forEach(function(item) { %>
        <div style="display:flex; gap:14px; align-items:center; border-bottom:1px solid var(--a-line); padding:12px 0;">
          <img src="<%= item.image || '/img/brand/logo-mark-256.png' %>" alt="<%= item.name || '' %>" style="width:56px; height:70px; object-fit:cover; border-radius:8px; border:1px solid var(--a-line);">
          <div style="flex:1;">
            <strong style="color:var(--a-ink); display:block;"><%= item.name || 'Nighty' %></strong>
            <small style="color:var(--a-muted); display:block;">Size: <strong style="color:var(--a-ink);"><%= item.size || 'Free' %></strong> · Qty: <strong style="color:var(--a-ink);"><%= item.quantity || 1 %></strong></small>
            <small style="color:var(--a-muted);">Price: ₹<%= (item.price || 0).toLocaleString('en-IN') %> each</small>
          </div>
          <div style="text-align:right;">
            <strong style="color:var(--a-ink);">₹<%= ((item.price || 0) * (item.quantity || 1)).toLocaleString('en-IN') %></strong>
          </div>
        </div>
      <% }); %>

      <div style="margin-top:16px;">
        <div style="display:flex; justify-content:space-between; padding:6px 0; color:var(--a-muted);">
          <span>Subtotal</span>
          <span style="color:var(--a-ink);">₹<%= (order.subtotal || 0).toLocaleString('en-IN') %></span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:6px 0; color:var(--a-muted);">
          <span>Flat Shipping</span>
          <span style="color:var(--a-ink);">₹<%= (order.shipping || 0).toLocaleString('en-IN') %></span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:10px 0; border-top:1px solid var(--a-line2); font-size:1.2rem; font-weight:600; color:var(--a-ink);">
          <span>Total Paid</span>
          <span style="color:var(--a-accent);">₹<%= (order.total || 0).toLocaleString('en-IN') %></span>
        </div>
      </div>
    </div>

    <!-- Customer & Delivery Address Card -->
    <div class="a-card">
      <h2 style="font-size:1.3rem; margin-bottom:12px; font-family:var(--a-serif); color:var(--a-ink);">Delivery Destination</h2>
      <p style="margin:0 0 6px; font-size:1.05rem; color:var(--a-ink);"><strong><%= order.customer?.name || 'Customer' %></strong></p>
      <p style="margin:0 0 6px; color:var(--a-muted);">WhatsApp: <strong style="color:var(--a-ink);"><%= order.customer?.phone || 'N/A' %></strong></p>
      <% if (order.customer?.email) { %>
        <p style="margin:0 0 6px; color:var(--a-muted);">Email: <span style="color:var(--a-ink);"><%= order.customer.email %></span></p>
      <% } %>
      <p style="margin:10px 0 0; line-height:1.6; color:var(--a-muted);">
        <span style="color:var(--a-ink);"><%= order.customer?.address || '' %></span><br>
        <%= order.customer?.city || '' %><%= order.customer?.city ? ', ' : '' %><%= order.customer?.state || 'Kerala' %> - <strong style="color:var(--a-ink);"><%= order.customer?.pin || '' %></strong>
      </p>
    </div>

    <!-- Payment Gateway Diagnostics -->
    <div class="a-card">
      <h2 style="font-size:1.3rem; margin-bottom:12px; font-family:var(--a-serif); color:var(--a-ink);">Payment Details</h2>
      <div style="font-size:0.88rem; color:var(--a-muted); display:grid; gap:8px;">
        <div>Gateway: <strong style="color:var(--a-ink);"><%= order.payment?.method || 'Razorpay' %></strong></div>
        <div>Razorpay Order ID: <code style="color:var(--a-accent);"><%= order.payment?.razorpayOrderId || 'N/A' %></code></div>
        <div>Razorpay Payment ID: <code style="color:var(--a-accent);"><%= order.payment?.razorpayPaymentId || 'N/A' %></code></div>
        <div>Payment Status: <strong style="color:var(--a-ink);"><%= order.payment?.status || 'N/A' %></strong></div>
        <% if (order.refund && (order.refund?.id || order.status === 'refund_needed' || order.status === 'refunded')) { %>
          <div style="margin-top:8px; padding-top:8px; border-top:1px dashed var(--a-line);">
            <div>Refund ID: <code style="color:var(--a-accent);"><%= order.refund?.id || 'Pending manual refund' %></code></div>
            <div>Refund Status: <strong><%= order.refund?.status || order.status %></strong></div>
            <% if (order.refund?.failureReason) { %>
              <div style="color:#b91c1c; font-size:0.82rem;">Reason: <%= order.refund.failureReason %></div>
            <% } %>
          </div>
        <% } %>
      </div>

      <% if (order.status === 'refund_needed' || order.status === 'refunded') { 
          const cleanCustPhone = (order.customer?.phone || '').replace(/\D/g, '').slice(-10);
          const refundText = order.status === 'refunded'
            ? `Hello ${order.customer?.name || 'Customer'}, regarding your order ${order.orderId || ''} at Nest by Ammakkili: A full refund of ₹${order.total || 0} has been automatically processed back to your original payment method (Refund ID: ${order.refund?.id || 'Processed'}). Thank you for your patience.`
            : `Hello ${order.customer?.name || 'Customer'}, regarding your order ${order.orderId || ''} at Nest by Ammakkili: Your payment of ₹${order.total || 0} was received after our 15-minute stock reservation expired. Our accounts team is processing your full refund directly to your account. Thank you.`;
          const waRefundLink = cleanCustPhone ? `https://wa.me/91${cleanCustPhone}?text=${encodeURIComponent(refundText)}` : '#';
      %>
        <div style="margin-top:14px; padding:12px; border-radius:10px; background:<%= order.status === 'refund_needed' ? '#fef2f2' : '#f0fdf4' %>; border:1px solid <%= order.status === 'refund_needed' ? '#f87171' : '#86efac' %>;">
          <div style="font-weight:600; font-size:0.88rem; color:<%= order.status === 'refund_needed' ? '#991b1b' : '#166534' %>; margin-bottom:6px;">
            <%= order.status === 'refund_needed' ? '⚠️ Refund Action Required' : '✅ Customer Refund Notification' %>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:8px;">
            <% if (waRefundLink !== '#') { %>
              <a href="<%= waRefundLink %>" target="_blank" rel="noopener noreferrer" class="a-btn a-btn--sm" style="background:#25D366; color:#fff; border:none; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                💬 Send WhatsApp Refund Message to Customer
              </a>
            <% } %>
            <% if (order.status === 'refund_needed') { %>
              <form method="POST" action="/admin/orders/<%= order._id %>/retry-refund" style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="a-btn a-btn--danger a-btn--sm" style="display:inline-flex; align-items:center; gap:6px;">
                  🔁 Retry Razorpay Refund
                </button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Status & Tracking Update Form -->
  <div>
    <div class="a-card" style="position:sticky; top:90px;">
      <h2 style="font-size:1.3rem; margin-bottom:16px; font-family:var(--a-serif); color:var(--a-ink);">Fulfillment & Tracking</h2>

      <form method="POST" action="/admin/orders/<%= order._id %>/status">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

        <div class="a-field">
          <label for="status">Order Status</label>
          <select id="status" name="status" style="font-weight:500;">
            <option value="pending_payment" <%= order.status === 'pending_payment' ? 'selected' : '' %>>pending_payment</option>
            <option value="paid" <%= order.status === 'paid' ? 'selected' : '' %>>paid (Payment Verified)</option>
            <option value="packed" <%= order.status === 'packed' ? 'selected' : '' %>>packed (Ready for Courier)</option>
            <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>shipped (Dispatched)</option>
            <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>delivered (Delivered to Customer)</option>
            <option value="refund_needed" <%= order.status === 'refund_needed' ? 'selected' : '' %>>refund_needed (Refund Action Needed)</option>
            <option value="refunded" <%= order.status === 'refunded' ? 'selected' : '' %>>refunded (Fully Refunded)</option>
            <option value="refund_pending" <%= order.status === 'refund_pending' ? 'selected' : '' %>>refund_pending</option>
            <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>cancelled</option>
            <option value="failed" <%= order.status === 'failed' ? 'selected' : '' %>>failed</option>
          </select>
        </div>

        <div class="a-field">
          <label for="courier">Courier Partner</label>
          <input id="courier" name="courier" value="<%= order.tracking?.courier || '' %>" placeholder="e.g. India Post, ST Courier, DTDC">
        </div>

        <div class="a-field">
          <label for="trackingId">Tracking ID / Waybill</label>
          <input id="trackingId" name="trackingId" value="<%= order.tracking?.trackingId || '' %>" placeholder="e.g. ST123456789IN">
        </div>

        <div class="a-field">
          <label for="adminNotes">Private Notes</label>
          <textarea id="adminNotes" name="adminNotes" rows="3" placeholder="Internal remarks, packing checks..."><%= order.adminNotes || '' %></textarea>
        </div>

        <button type="submit" class="a-btn" style="width:100%;">Update Order</button>
      </form>
    </div>
  </div>
</div>

