<div style="margin-bottom:24px;">
  <a href="/admin/customers" class="tlink" style="margin-left:0; font-size:0.8rem;">← Back to Customers</a>
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-top:8px;">
    <div style="display:flex; align-items:center; gap:16px;">
      <% if (customer.avatarUrl) { %>
        <img src="<%= customer.avatarUrl %>" alt="" style="width:54px; height:54px; border-radius:50%; object-fit:cover;">
      <% } %>
      <div>
        <h1 style="font-size:2rem; margin:0;"><%= customer.name %></h1>
        <p style="color:var(--admin-muted); margin:2px 0 0;"><%= customer.email %> • Joined <%= new Date(customer.createdAt).toLocaleDateString('en-IN') %></p>
      </div>
    </div>
  </div>
</div>

<div class="two2">
  <!-- Orders by this Customer -->
  <div>
    <div class="admin-card">
      <h2 style="font-size:1.3rem; margin-bottom:16px;">Customer Order History (<%= orders.length %>)</h2>

      <% if (orders.length === 0) { %>
        <p style="color:var(--admin-muted); padding:20px 0;">No orders associated with this customer.</p>
      <% } else { %>
        <div style="display:grid; gap:16px;">
          <% orders.forEach(function(o) { %>
            <div style="border:1px solid var(--admin-border); border-radius:14px; padding:18px; background:#fff;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <strong><a href="/admin/orders/<%= o._id %>" style="color:var(--admin-c1); font-size:1.1rem;"><%= o.orderId %></a></strong>
                <span class="tag-badge status-<%= o.status %>"><%= o.status.replace('_', ' ') %></span>
              </div>

              <div style="font-size:0.88rem; color:var(--admin-muted); margin-bottom:8px;">
                Placed: <%= new Date(o.createdAt).toLocaleDateString('en-IN') %> • Total: <strong>₹<%= o.total.toLocaleString('en-IN') %></strong>
              </div>

              <ul style="margin:8px 0; padding-left:18px; font-size:0.85rem; color:var(--admin-muted);">
                <% o.items.forEach(function(i) { %>
                  <li><%= i.name %> (Size: <%= i.size %>) × <%= i.quantity %></li>
                <% }); %>
              </ul>

              <div style="margin-top:12px; text-align:right;">
                <a href="/admin/orders/<%= o._id %>" class="btn small ghost" style="padding:4px 10px; font-size:0.75rem;">Manage Order</a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Saved Addresses -->
  <div>
    <div class="admin-card">
      <h2 style="font-size:1.3rem; margin-bottom:16px;">Saved Delivery Addresses (<%= customer.addresses.length %>)</h2>

      <% if (customer.addresses.length === 0) { %>
        <p style="color:var(--admin-muted); padding:16px 0;">Customer has not saved any addresses yet.</p>
      <% } else { %>
        <div style="display:grid; gap:14px;">
          <% customer.addresses.forEach(function(addr) { %>
            <div style="border:1px solid var(--admin-border); border-radius:12px; padding:14px; background:#fff;">
              <div style="display:flex; justify-content:space-between;">
                <strong><%= addr.label %></strong>
                <% if (addr.isDefault) { %>
                  <span style="font-size:0.72rem; background:var(--admin-c1); color:#fff; padding:2px 6px; border-radius:4px;">Default</span>
                <% } %>
              </div>
              <p style="margin:6px 0 0; font-size:0.88rem; line-height:1.4; color:var(--admin-muted);">
                <%= addr.name %> (<%= addr.phone %>)<br>
                <%= addr.address %>, <%= addr.city %> - <%= addr.pin %>
              </p>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Security & Privacy Notes -->
    <div class="admin-card" style="border-left:4px solid #059669;">
      <h3 style="font-size:1rem; margin-bottom:8px; color:#059669;">Google OAuth Security</h3>
      <p style="font-size:0.82rem; color:var(--admin-muted); line-height:1.5; margin:0;">
        Identity verified by Google OAuth 2.0. No passwords or tokens are stored on this server. Customer can request account deletion at any time from their portal.
      </p>
    </div>
  </div>
</div>

