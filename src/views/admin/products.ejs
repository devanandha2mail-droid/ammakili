<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:14px;">
  <div>
    <h1>Products</h1>
    <p style="margin:4px 0 0;">Manage your nighty designs, images, pricing, and stock.</p>
  </div>
  <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    <% if (typeof hasSampleProducts !== 'undefined' && hasSampleProducts) { %>
      <form method="POST" action="/admin/products/delete-samples" onsubmit="return confirm('Delete all sample products? Real products will not be affected.');" style="display:inline;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="a-btn a-btn--danger a-btn--sm">Delete all sample products</button>
      </form>
    <% } %>
    <a href="/admin/products/add" class="a-btn">+ Add New Nighty</a>
  </div>
</div>

<!-- Filters -->
<form method="GET" action="/admin/products" class="a-card" style="padding:18px 24px; margin-bottom:24px;">
  <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center;">
    <input name="q" value="<%= q %>" placeholder="Search by English or Malayalam name / slug..." style="flex:2 1 240px; font-size:0.9rem;">
    <select name="style" onchange="this.form.submit()" style="flex:1 1 140px; font-size:0.9rem;">
      <option value="">All Styles</option>
      <% styles.forEach(function(s) { %>
        <option value="<%= s %>" <%= selectedStyle === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
    <select name="status" onchange="this.form.submit()" style="flex:1 1 140px; font-size:0.9rem;">
      <option value="">All Statuses</option>
      <option value="active" <%= selectedStatus === 'active' ? 'selected' : '' %>>Active only</option>
      <option value="inactive" <%= selectedStatus === 'inactive' ? 'selected' : '' %>>Inactive only</option>
    </select>
    <button type="submit" class="a-btn a-btn--sm">Search</button>
    <% if (q || selectedStyle || selectedStatus) { %>
      <a href="/admin/products" class="a-btn a-btn--ghost a-btn--sm">Reset</a>
    <% } %>
  </div>
</form>

<!-- Products Table -->
<div class="a-card">
  <% if (products.length === 0) { %>
    <p style="padding:20px 0; text-align:center;">No nighties match your query.</p>
  <% } else { %>
    <div class="a-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Photo</th>
            <th>Name</th>
            <th>Style</th>
            <th>Price</th>
            <th>Stock Breakdown</th>
            <th>Featured</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(p) { %>
            <tr>
              <td style="width:60px;">
                <img src="<%= typeof p.getMainImage === 'function' ? p.getMainImage() : (p.images && p.images[0] ? (p.images[0].url || p.images[0]) : '/img/logo.svg') %>" alt="<%= p.name.en %>" style="width:48px; height:60px; object-fit:cover; border-radius:8px; border:1px solid var(--a-line);">
              </td>
              <td>
                <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                  <strong><%= p.name.en %></strong>
                  <% if (p.isSample) { %>
                    <span class="a-sample">Sample</span>
                  <% } %>
                </div>
                <% if (p.name.ml) { %>
                  <div style="font-size:0.82rem; color:var(--a-muted);"><%= p.name.ml %></div>
                <% } %>
                <div style="font-size:0.75rem; color:var(--a-dim);"><%= p.slug %></div>
              </td>
              <td><%= p.style %></td>
              <td><strong>₹<%= p.price.toLocaleString('en-IN') %></strong></td>
              <td>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                  <% p.sizes.forEach(function(s) { %>
                    <% 
                      let pill = 'a-pill';
                      if (s.stock === 0) pill += ' a-pill--bad';
                      else if (s.stock <= 3) pill += ' a-pill--warn';
                      else pill += ' a-pill--info';
                    %>
                    <span class="<%= pill %>" style="padding:2px 8px; font-size:0.72rem;">
                      <%= s.size %>: <%= s.stock %>
                    </span>
                  <% }); %>
                </div>
              </td>
              <td><%= p.featured ? '⭐ Yes' : 'No' %></td>
              <td>
                <span class="a-pill <%= p.active ? 'a-pill--ok' : 'a-pill--bad' %>">
                  <%= p.active ? 'Active' : 'Hidden' %>
                </span>
              </td>
              <td>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                  <a href="/admin/products/edit/<%= p._id %>" class="a-btn a-btn--ghost a-btn--sm">Edit</a>
                  <a href="/product/<%= p.slug %>" target="_blank" rel="noopener" class="a-btn a-btn--ghost a-btn--sm">View</a>
                  <form method="POST" action="/admin/products/delete/<%= p._id %>" onsubmit="return confirm('Delete this product permanently?');" style="display:inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="a-btn a-btn--danger a-btn--sm">Del</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
