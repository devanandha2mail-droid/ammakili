<% 
  let bannerText = '';
  let bannerLink = '';
  if (banner && banner.active) {
    bannerText = banner.getText(lang);
    bannerLink = banner.link;
  } else if (settings && settings.announcementText) {
    bannerText = (lang === 'ml' && settings.announcementText.ml) ? settings.announcementText.ml : settings.announcementText.en;
  }
%>
<% if (bannerText) { %>
  <div class="announcement-bar" id="announcementBar" style="display:none;" data-text-hash="<%= Buffer.from(bannerText).toString('base64').substring(0, 16) %>">
    <div class="announcement-content">
      <span class="announcement-msg"><%= bannerText %></span>
      <% if (bannerLink) { %>
        <a href="<%= bannerLink %>" class="announcement-link"><%= lang === 'ml' ? 'കൂടുതൽ അറിയാൻ →' : 'View collection →' %></a>
      <% } %>
    </div>
    <button type="button" class="announcement-close" id="closeAnnouncement" aria-label="Dismiss announcement">&times;</button>
  </div>
  <script>
    (function() {
      try {
        var bar = document.getElementById('announcementBar');
        if (!bar) return;
        var hash = bar.getAttribute('data-text-hash');
        var dismissed = localStorage.getItem('nest_bar_dismissed');
        if (dismissed !== hash) {
          bar.style.display = 'flex';
        }
        var closeBtn = document.getElementById('closeAnnouncement');
        if (closeBtn) {
          closeBtn.addEventListener('click', function() {
            bar.style.display = 'none';
            try { localStorage.setItem('nest_bar_dismissed', hash); } catch(e) {}
          });
        }
      } catch(e) {}
    })();
  </script>
<% } %>
