<%
  let annText = '';
  if (typeof settings !== 'undefined' && settings && settings.announcementText) {
    if (typeof settings.announcementText === 'string') {
      annText = settings.announcementText.trim();
    } else if (typeof settings.announcementText === 'object') {
      annText = (typeof lang !== 'undefined' && lang === 'ml' ? (settings.announcementText.ml || settings.announcementText.en) : (settings.announcementText.en || settings.announcementText.ml)) || '';
      if (typeof annText === 'string') annText = annText.trim();
    }
  }
  let annLink = (typeof settings !== 'undefined' && settings && settings.announcementLink) || '/shop';
%>
<% if (annText) { %>
<div class="announce" id="announce">
  <p class="announce-text"><%= annText %><% if (annLink) { %> <a href="<%= annLink %>"><%= typeof lang !== 'undefined' && lang === 'ml' ? 'ഇവിടെ കാണുക' : 'Shop the collection' %></a><% } %></p>
  <button class="announce-x" id="announceX" type="button" aria-label="Dismiss announcement">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</div>
<% } %>

<header class="site-header" id="siteHeader">
  <div class="hdr">

    <a class="lockup" href="/" aria-label="Nest by Ammakkili, home">
      <img src="/img/brand/logo-full-128.png"
           srcset="/img/brand/logo-full-128.png 1x, /img/brand/logo-full-256.png 2x"
           width="52" height="52" alt="">
      <span class="lockup-text"><b>Nest</b><small>by Ammakkili</small></span>
    </a>

    <nav class="main-nav" aria-label="Main">
      <a href="/shop"<%- (typeof path !== 'undefined' && path === '/shop') ? ' aria-current="page"' : '' %>>Shop</a>
      <a href="/size-guide"<%- (typeof path !== 'undefined' && (path === '/size-guide' || path === '/sizes')) ? ' aria-current="page"' : '' %>>Size guide</a>
      <a href="/about"<%- (typeof path !== 'undefined' && path === '/about') ? ' aria-current="page"' : '' %>>About</a>
      <a href="/contact"<%- (typeof path !== 'undefined' && path === '/contact') ? ' aria-current="page"' : '' %>>Contact</a>
    </nav>

    <div class="tools">
      <% if (typeof lang !== 'undefined' && lang === 'ml') { %>
        <a class="tool lang" href="/lang/en" lang="en" hreflang="en">EN</a>
      <% } else { %>
        <a class="tool lang" href="/lang/ml" lang="ml" hreflang="ml">മലയാളം</a>
      <% } %>

      <div class="acct" id="acct">
        <button class="tool" id="acctBtn" type="button" aria-label="Account"
                aria-haspopup="true" aria-expanded="false" aria-controls="acctMenu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
        </button>
        <div class="menu" id="acctMenu" hidden>
          <% if (typeof customer !== 'undefined' && customer) { %>
            <a class="menu-google" href="/account">
              <%= customer.name %>
            </a>
            <a href="/account">My account</a>
            <a href="/orders">Orders</a>
            <a href="/logout">Sign out</a>
          <% } else { %>
            <a class="menu-google" href="/auth/google">
              <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.2 5.5-4.7 7.2l7.6 5.9c4.4-4.1 6.9-10.1 6.9-17.6z"/><path fill="#FBBC05" d="M10.5 28.7a14.5 14.5 0 0 1 0-9.4l-7.9-6.1a24 24 0 0 0 0 21.6l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4.1-13.5-9.9l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
              Sign in with Google
            </a>
          <% } %>
          <hr>
          <a href="/track-order">Track order</a>
          <a href="/wishlist">Wishlist</a>
          <button type="button" data-theme-toggle>Theme <span class="val" data-theme-label>Light</span></button>
        </div>
      </div>

      <a class="tool wish" href="/wishlist" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.7 3.6 4.5 7 4.5c2 0 3.5 1.1 5 3 1.5-1.9 3-3 5-3 3.4 0 5.4 3.2 4.2 6.6-1.7 4.8-9.2 9.4-9.2 9.4z"/></svg>
        <span class="badge" id="wishBadge" data-zero="true">0</span>
      </a>

      <a class="tool" href="/cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span class="badge" id="cartBadge" data-zero="true">0</span>
      </a>

      <button class="tool burger" id="burger" type="button" aria-label="Open menu"
              aria-expanded="false" aria-controls="drawer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
    </div>

  </div>
</header>

<div class="drawer" id="drawer" hidden>
  <div class="drawer-bg" data-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer-top">
      <a class="lockup" href="/" aria-label="Nest by Ammakkili, home">
        <img src="/img/brand/logo-full-128.png" width="44" height="44" alt="">
        <span class="lockup-text"><b>Nest</b><small>by Ammakkili</small></span>
      </a>
      <button class="tool" id="drawerClose" type="button" aria-label="Close menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav class="drawer-nav" aria-label="Menu">
      <a href="/shop">Shop</a>
      <a href="/size-guide">Size guide</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/how-to-order">How to order</a>
      <a href="/track-order">Track order</a>
      <a href="/wishlist">Wishlist</a>
    </nav>
    <div class="drawer-foot">
      <div class="drawer-row">
        <% if (typeof lang !== 'undefined' && lang === 'ml') { %>
          <a class="pill" href="/lang/en" lang="en" hreflang="en">EN</a>
        <% } else { %>
          <a class="pill" href="/lang/ml" lang="ml" hreflang="ml">മലയാളം</a>
        <% } %>
        <button class="pill" type="button" data-theme-toggle>Theme: <span data-theme-label>Light</span></button>
      </div>
      <% if (typeof customer !== 'undefined' && customer) { %>
        <a class="menu-google solid" href="/account">
          <%= customer.name %>
        </a>
        <div class="drawer-row">
          <a class="pill" href="/account">My account</a>
          <a class="pill" href="/orders">Orders</a>
        </div>
        <a class="pill" href="/logout" style="text-align:center;">Sign out</a>
      <% } else { %>
        <a class="menu-google solid" href="/auth/google">
          <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.2 5.5-4.7 7.2l7.6 5.9c4.4-4.1 6.9-10.1 6.9-17.6z"/><path fill="#FBBC05" d="M10.5 28.7a14.5 14.5 0 0 1 0-9.4l-7.9-6.1a24 24 0 0 0 0 21.6l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4.1-13.5-9.9l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
          Sign in with Google
        </a>
      <% } %>
    </div>
  </div>
</div>
