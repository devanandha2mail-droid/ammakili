<footer>
  <div class="wrap">
    <div class="fc">
      <div>
        <a class="brand" href="/" style="margin-bottom:16px; display:inline-flex; align-items:center; gap:16px;" aria-label="Nest by Ammakkili - Home">
          <div style="background:rgba(255, 255, 255, 0.9); border-radius:50%; padding:8px; box-shadow:0 6px 20px rgba(0,0,0,0.2); display:grid; place-items:center;">
            <picture>
              <source srcset="/img/brand/logo-full-512.webp" type="image/webp">
              <img 
                src="/img/brand/logo-full-128.png" 
                srcset="/img/brand/logo-full-128.png 128w, /img/brand/logo-full-256.png 256w, /img/brand/logo-full-512.png 512w" 
                sizes="100px" 
                width="100" 
                height="100" 
                alt="Nest by Ammakkili logo"
                style="display:block;"
              >
            </picture>
          </div>
          <div>
            <span style="font-family:var(--serif); font-size:1.8rem; font-style:italic; color:#fff; display:block; line-height:1;">Nest</span>
            <span style="font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; opacity:0.9;">by Ammakkili</span>
          </div>
        </a>
        <p><%= t('footer.desc') %></p>
        <p style="font-size:0.88rem; opacity:0.85; margin-top:8px;">
          <span>💬 WhatsApp support only • No phone calls</span>
        </p>
        <div style="margin-top:14px;">
          <a href="https://www.youtube.com/@nestammakkili" target="_blank" rel="noopener" class="btn small ghost" style="color:#fff; border-color:rgba(255,255,255,0.4);">
            ▶ Watch on YouTube
          </a>
        </div>
      </div>

      <div>
        <h4><%= t('footer.shopHeading') %></h4>
        <ul>
          <li><a href="/shop"><%= t('nav.shop') %></a></li>
          <li><a href="/sizes"><%= t('nav.sizes') %></a></li>
          <li><a href="/how-to-order"><%= t('nav.howToOrder') %></a></li>
          <li><a href="/wishlist"><%= t('nav.wishlist') %></a></li>
          <li><a href="/cart"><%= t('nav.cart') %></a></li>
          <li><a href="/track"><%= t('nav.track') %></a></li>
        </ul>
      </div>

      <div>
        <h4><%= t('footer.helpHeading') %></h4>
        <ul>
          <li><a href="/faq"><%= t('faq.title') %></a></li>
          <li><a href="/policies"><%= t('policies.title') %></a></li>
          <li><a href="/about"><%= t('nav.about') %></a></li>
          <li><a href="/contact"><%= t('nav.contact') %></a></li>
          <li>
            <button type="button" data-theme-toggle class="theme-footer-btn" style="background:transparent; border:none; color:inherit; font:inherit; cursor:pointer; padding:0; display:inline-flex; align-items:center; gap:6px; opacity:0.85;">
              Theme: <span data-theme-label>Light</span>
            </button>
          </li>
          <li><a href="/admin/login" style="opacity:0.6; font-size:0.75rem;">Admin Access</a></li>
        </ul>
      </div>
    </div>

    <div class="copy">
      <span>© 2026 Nest by Ammakkili. <%= t('footer.allRights') %></span>
      <span>Flat ₹<%= (settings && settings.shippingCharge) || 60 %> shipping • Prepaid orders only • No returns or exchanges</span>
    </div>
  </div>
</footer>

