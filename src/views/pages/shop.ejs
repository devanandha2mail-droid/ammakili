<div class="wrap pg">
  <div class="head">
    <hr class="rule">
    <h2><%= t('shop.title') %></h2>
    <p class="lead"><%= t('shop.lead') %></p>
  </div>

  <!-- Sticky Filter Bar under Header -->
  <div class="shop-filter-bar" id="shopFilterBar" data-current-style="<%= currentStyle %>">
    <div class="shop-filter-bar__inner">
      <!-- Style Filter Chips -->
      <div class="shop-chips" role="region" aria-label="Filter by fabric style">
        <button 
          type="button" 
          class="shop-chip <%= (!currentStyle || currentStyle.toLowerCase() === 'all') ? 'is-active' : '' %>" 
          data-style="All"
          aria-pressed="<%= (!currentStyle || currentStyle.toLowerCase() === 'all') ? 'true' : 'false' %>"
        >
          <%= lang === 'ml' ? 'എല്ലാം' : 'All styles' %>
        </button>
        <% 
          // Always ensure core styles exist: Cotton, Satin, Printed, Plain
          const coreStyles = ['Cotton', 'Satin', 'Printed', 'Plain'];
          const allUniqueStyles = Array.from(new Set([...coreStyles, ...(styles || [])]));
          allUniqueStyles.forEach(function(st) { 
            const active = currentStyle && currentStyle.toLowerCase() === st.toLowerCase();
        %>
          <button 
            type="button" 
            class="shop-chip <%= active ? 'is-active' : '' %>" 
            data-style="<%= st %>"
            aria-pressed="<%= active ? 'true' : 'false' %>"
          >
            <%= st %>
          </button>
        <% }); %>
      </div>

      <!-- Right controls: Sort Dropdown & Search -->
      <div class="shop-filter-actions">
        <form id="shopSearchForm" class="shop-search-form" role="search">
          <input 
            type="search" 
            id="shopSearchInput" 
            name="q" 
            placeholder="<%= t('shop.searchPlaceholder') %>" 
            value="<%= searchQuery %>"
            aria-label="<%= t('shop.searchPlaceholder') %>"
          >
        </form>

        <div class="shop-sort-wrap">
          <label for="shopSortSelect" class="sr-only">Sort designs</label>
          <select id="shopSortSelect" class="shop-sort-select" aria-label="Sort designs">
            <option value="featured" <%= (!currentSort || currentSort === 'featured') ? 'selected' : '' %>>
              <%= lang === 'ml' ? 'പ്രത്യേകം തിരഞ്ഞെടുത്തവ' : 'Featured' %>
            </option>
            <option value="price-asc" <%= (currentSort === 'price-asc' || currentSort === 'lo') ? 'selected' : '' %>>
              <%= lang === 'ml' ? 'വില: കുറഞ്ഞതിൽ നിന്ന് കൂടുതൽ' : 'Price: Low to High' %>
            </option>
            <option value="price-desc" <%= (currentSort === 'price-desc' || currentSort === 'hi') ? 'selected' : '' %>>
              <%= lang === 'ml' ? 'വില: കൂടുതൽ നിന്ന് കുറഞ്ഞതിലേക്ക്' : 'Price: High to Low' %>
            </option>
            <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>
              <%= lang === 'ml' ? 'പുതിയവ ആദ്യം' : 'Newest' %>
            </option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Result Count -->
  <div class="shop-meta-row">
    <p class="cnt" id="shopCount">
      <%= totalCount %> <%= totalCount === 1 ? t('shop.singleDesignCount') : t('shop.designCount') %>
    </p>
  </div>

  <!-- Products Grid -->
  <div 
    class="grid shop-grid" 
    id="shopGrid" 
    data-total-pages="<%= totalPages %>"
    data-current-page="<%= currentPage %>"
  >
    <% 
      const activeSearch = (typeof searchQuery !== 'undefined' && searchQuery) || (typeof q !== 'undefined' && q);
      if (products.length === 0) { 
    %>
      <% if (activeSearch || currentStyle) { %>
        <div class="shop-empty-state">
          <p class="shop-empty-text"><%= t('shop.noResults') %></p>
          <a href="/shop" class="btn small"><%= t('shop.clearFilter') %></a>
        </div>
      <% } else { %>
        <div class="shop-empty-state" style="padding:60px 20px; text-align:center; grid-column: 1 / -1;">
          <h2 style="font-family:var(--serif); font-size:1.8rem; font-style:italic; color:var(--ink); margin-bottom:12px;">
            <%= lang === 'ml' ? 'പുതിയ ഡിസൈനുകൾ ഉടൻ ലഭ്യമാകും' : 'New designs are on the way' %>
          </h2>
          <p style="color:var(--muted); max-width:480px; margin:0 auto 24px; font-size:0.95rem; line-height:1.5;">
            <%= lang === 'ml' 
              ? 'ഞങ്ങളുടെ പുതിയ കളക്ഷൻ തയാറായി വരുന്നു. ഏറ്റവും പുതിയ വിവരങ്ങൾക്കായി ഞങ്ങളുടെ വാട്സാപ്പിലോ യൂട്യൂബിലോ ബന്ധപ്പെടുക.'
              : 'We are currently preparing our next collection of breathable, softly considered nightwear.' %>
          </p>
          <div style="display:flex; justify-content:center; gap:12px; flex-wrap:wrap;">
            <a href="https://www.youtube.com/@nestammakkili" target="_blank" rel="noopener" class="btn small">Watch on YouTube</a>
            <a href="https://wa.me/<%= whatsappNumber %>" target="_blank" rel="noopener" class="btn small btn-outline">Chat on WhatsApp</a>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <% products.forEach(function(p) { %>
        <%- include('../partials/product-card', { p: p, lang: lang }) %>
      <% }); %>
    <% } %>
  </div>

  <!-- Load More Button -->
  <div class="shop-load-more-wrap" id="shopLoadMoreWrap" <%= (currentPage >= totalPages) ? 'hidden' : '' %>>
    <button type="button" class="btn ghost shop-load-more-btn" id="shopLoadMoreBtn">
      <%= lang === 'ml' ? 'കൂടുതൽ കാണുക' : 'Load more designs' %>
    </button>
  </div>
</div>

<script src="/js/shop-page.js" defer></script>
