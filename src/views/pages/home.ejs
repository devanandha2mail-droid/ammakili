<div class="wrap hero">
  <div>
    <h1><%- t('home.heroTitle') %></h1>
    <p><%= t('home.heroDesc') %></p>
    <a class="btn" href="/shop"><%= t('home.exploreCollection') %></a>
    <a class="tlink" href="/sizes"><%= t('home.findYourSize') %></a>
  </div>
  <div class="arch hero-product-arch">
    <% if (featuredProduct && featuredProduct.images && featuredProduct.images.length > 0) { %>
      <img src="<%= featuredProduct.images[0] %>" alt="<%= featuredProduct.getName(lang) %>" width="400" height="500">
      <div class="hero-caption-bar">
        <div class="hero-caption-info">
          <strong><%= featuredProduct.getName(lang) %></strong>
          <span class="price">₹<%= featuredProduct.price.toLocaleString('en-IN') %></span>
        </div>
        <a href="/product/<%= featuredProduct.slug %>" class="btn small"><%= lang === 'ml' ? 'വാങ്ങുക' : 'Shop now' %></a>
      </div>
    <% } else { %>
      <div class="hero-fallback-pattern">
        <span><%= lang === 'ml' ? 'പുതിയ ശേഖരം' : 'New arrivals' %></span>
        <a href="/shop" class="btn small ghost"><%= lang === 'ml' ? 'കാണുക' : 'Explore' %></a>
      </div>
    <% } %>
  </div>
</div>

<div class="trust-strip">
  <div class="wrap trust-grid">
    <div class="trust-item"><span class="check" aria-hidden="true">✓</span> <span><%= lang === 'ml' ? 'പ്രീപെയ്ഡ് ഓർഡറുകൾ മാത്രം' : 'Prepaid orders only' %></span></div>
    <div class="trust-item"><span class="check" aria-hidden="true">✓</span> <span><%= lang === 'ml' ? 'കൃത്യമായ സൈസ് ഗൈഡ്' : 'Clear size guide' %></span></div>
    <div class="trust-item"><span class="check" aria-hidden="true">✓</span> <span><%= lang === 'ml' ? 'വാട്സാപ്പിൽ സപ്പോർട്ട്' : 'Support on WhatsApp' %></span></div>
  </div>
</div>

<div class="statement">
  <div class="wrap">
    <p><%= t('home.statement') %></p>
  </div>
</div>

<div class="wrap">
  <!-- New Arrivals Section -->
  <section>
    <div class="head">
      <hr class="rule">
      <h2><%= t('home.newArrivals') %></h2>
      <p class="lead"><%= t('home.newArrivalsLead') %></p>
    </div>
    <div class="grid">
      <% products.forEach(function(p) { %>
        <div class="item">
          <div class="pw">
            <a class="ph" href="/product/<%= p.slug %>" aria-label="<%= p.getName(lang) %>">
              <% if (p.images && p.images.length > 0) { %>
                <img src="<%= p.images[0] %>" alt="<%= p.getName(lang) %>" loading="lazy" width="400" height="500">
              <% } else { %>
                <svg viewBox="0 0 60 100" aria-hidden="true"><path d="M22 4h16l3 14 6 6-5 8 9 60H9l9-60-5-8 6-6z"/></svg>
              <% } %>
              <% if (p.tag && p.tag !== 'None') { %>
                <span class="badge <%= p.tag === 'Bestseller' ? 'bestseller' : '' %>"><%= p.tag %></span>
              <% } %>
            </a>
            <button type="button" class="hbtn cardh" data-wish-id="<%= p._id %>" data-wish-name="<%= p.getName(lang) %>" aria-label="Save <%= p.getName(lang) %> to wishlist">♡</button>
          </div>
          <div class="meta">
            <h3><a href="/product/<%= p.slug %>"><%= p.getName(lang) %></a></h3>
            <div class="price">₹<%= p.price.toLocaleString('en-IN') %></div>
            <small><%= p.style %></small>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- Browse by Style Section -->
  <section>
    <div class="head">
      <hr class="rule">
      <h2><%= t('home.browseByStyle') %></h2>
    </div>
    <div class="index">
      <a href="/shop?style=Cotton">
        <b><%= t('home.styles.cotton') %></b>
        <span><%= t('home.styles.cottonSub') %></span>
      </a>
      <a href="/shop?style=Satin">
        <b><%= t('home.styles.satin') %></b>
        <span><%= t('home.styles.satinSub') %></span>
      </a>
      <a href="/shop?style=Printed">
        <b><%= t('home.styles.printed') %></b>
        <span><%= t('home.styles.printedSub') %></span>
      </a>
      <a href="/shop?style=Plain">
        <b><%= t('home.styles.plain') %></b>
        <span><%= t('home.styles.plainSub') %></span>
      </a>
    </div>
  </section>

  <!-- Before You Order Policy Highlights -->
  <section>
    <div class="head">
      <hr class="rule">
      <h2><%= t('home.beforeYouOrder') %></h2>
    </div>
    <div class="terms">
      <div>
        <h3><%= t('home.terms.paymentTitle') %></h3>
        <p><%= t('home.terms.paymentDesc') %></p>
      </div>
      <div>
        <h3><%= t('home.terms.returnsTitle') %></h3>
        <p><%= t('home.terms.returnsDesc') %></p>
      </div>
      <div>
        <h3><%= t('home.terms.contactTitle') %></h3>
        <p><%= t('home.terms.contactDesc') %></p>
      </div>
    </div>
  </section>
</div>

<!-- YouTube Showcase Banner -->
<div class="yt">
  <h2><%= t('home.ytTitle') %></h2>
  <p><%= t('home.ytDesc') %></p>
  <a class="btn" href="https://www.youtube.com/@nestammakkili" target="_blank" rel="noopener"><%= t('home.ytBtn') %></a>
</div>

