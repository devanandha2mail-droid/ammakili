<div class="wrap pg narrow" style="text-align:center;">
  <div class="arch" style="width:72px; height:88px; margin:0 auto 20px; aspect-ratio:auto;">
    <svg viewBox="0 0 60 100" style="width:40%;"><path d="M22 4h16l3 14 6 6-5 8 9 60H9l9-60-5-8 6-6z"/></svg>
  </div>

  <h2><%= t('nav.login') || 'Sign in to Nest' %></h2>
  <p class="lead" style="margin-bottom:28px;">
    Access your saved addresses, track past orders, and sync your favorite nighty designs across devices.
  </p>

  <% if (error) { %>
    <div style="background:#fee2e2; color:#991b1b; padding:12px 16px; border-radius:12px; font-size:0.88rem; margin:0 auto 24px; max-width:400px; text-align:left;">
      ⚠️ <%= error %>
    </div>
  <% } %>

  <div style="max-width:360px; margin:0 auto;">
    <!-- Official Google Sign In Button -->
    <a 
      href="/auth/google?returnTo=<%= encodeURIComponent(returnTo) %>" 
      class="google-btn"
      style="display:flex; align-items:center; justify-content:center; gap:14px; background:#ffffff; color:#3c4043; border:1px solid #dadce0; border-radius:999px; padding:12px 24px; font-family:'Jost', system-ui, sans-serif; font-size:0.92rem; font-weight:500; text-decoration:none; box-shadow:0 2px 6px rgba(0,0,0,0.08); transition:all 0.2s;"
      onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)'; this.style.borderColor='#d2e3fc';"
      onmouseout="this.style.boxShadow='0 2px 6px rgba(0,0,0,0.08)'; this.style.borderColor='#dadce0';"
    >
      <svg width="20" height="20" viewBox="0 0 48 48">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.79l7.97-6.2z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      <span>Continue with Google</span>
    </a>

    <p style="font-size:0.8rem; color:var(--muted); margin-top:24px; line-height:1.5;">
      We only receive your name and verified email from Google. We never post or access your credentials.
    </p>

    <div style="margin-top:32px; border-top:1px solid var(--line); padding-top:20px;">
      <p style="font-size:0.88rem; color:var(--muted); margin-bottom:12px;">Prefer to order without signing in?</p>
      <a href="/shop" class="btn small ghost">Continue as Guest</a>
    </div>
  </div>
</div>
