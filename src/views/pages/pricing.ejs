<div class="wrap pg narrow">
  <%- include('../partials/legal-template-warning') %>

  <hr class="rule" style="margin-left:0;">
  <h2><%= t('pricing.title') %></h2>
  <p class="lead" style="max-width:none;"><%= t('pricing.lead') %></p>

  <div style="margin-top:28px; display:flex; flex-direction:column; gap:20px;">
    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('pricing.currencyTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;"><%= t('pricing.currencyText') %></p>
    </div>

    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('pricing.shippingTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;">
        <%= t('pricing.shippingText') %> (Standard delivery fee: ₹<%= settings.shippingCharge || 60 %>).
      </p>
    </div>

    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('pricing.prepaidTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;"><%= t('pricing.prepaidText') %></p>
    </div>

    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('pricing.changesTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;"><%= t('pricing.changesText') %></p>
    </div>
  </div>

  <%- include('../partials/legal-contact-card') %>
</div>

