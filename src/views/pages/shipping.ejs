<div class="wrap pg narrow">
  <%- include('../partials/legal-template-warning') %>

  <hr class="rule" style="margin-left:0;">
  <h2><%= t('shipping.title') %></h2>
  <p class="lead" style="max-width:none;"><%= t('shipping.lead') %></p>

  <div style="margin-top:28px; display:flex; flex-direction:column; gap:20px;">
    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('shipping.rateTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;">
        <%= t('shipping.rateText') %> Current standard rate: <strong>₹<%= settings.shippingCharge || 60 %></strong>.
      </p>
    </div>

    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('shipping.timelineTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;">
        <%= t('shipping.timelineText') %> Typical delivery window is between <strong><%= settings.minDeliveryDays || 3 %> to <%= settings.maxDeliveryDays || 7 %> business days</strong>.
      </p>
    </div>

    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('shipping.trackingTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;"><%= t('shipping.trackingText') %></p>
    </div>

    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('shipping.addressTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;"><%= t('shipping.addressText') %></p>
    </div>
  </div>

  <%- include('../partials/legal-contact-card') %>
</div>

