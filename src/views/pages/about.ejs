<div class="wrap pg narrow">
  <!-- Brand Medallion in Glass Frame -->
  <div style="text-align:center; margin-bottom:36px;">
    <div class="item" style="display:inline-block; padding:24px; border-radius:36px; background:var(--glass2); box-shadow:var(--sh);">
      <picture>
        <source srcset="/img/brand/logo-full-512.webp" type="image/webp">
        <img 
          src="/img/brand/logo-full-512.png" 
          srcset="/img/brand/logo-full-256.png 256w, /img/brand/logo-full-512.png 512w, /img/brand/logo-full-1024.png 1024w" 
          sizes="260px" 
          width="260" 
          height="260" 
          alt="Nest by Ammakkili logo"
          style="display:block; max-width:100%; height:auto; filter:drop-shadow(0 8px 18px rgba(137, 34, 69, 0.25));"
        >
      </picture>
    </div>
  </div>

  <hr class="rule" style="margin-left:auto; margin-right:auto;">
  <h2 style="text-align:center;"><%= t('about.title') %></h2>
  <p class="lead" style="max-width:none; margin-bottom:20px;"><%= t('about.p1') %></p>
  <p class="lead" style="max-width:none; margin-bottom:20px;"><%= t('about.p2') %></p>
  <p class="lead" style="max-width:none; margin-bottom:20px;"><%= t('about.p3') %></p>
  
  <div style="margin-top:32px; padding:24px; border-radius:20px; background:var(--glass2); border:1px solid var(--gb);">
    <h3 style="font-size:1.3rem; margin-bottom:8px;">Watch Our Showcase</h3>
    <p style="color:var(--muted); font-size:0.95rem; margin-bottom:16px;">
      Explore nighty drapes, neckline tailoring, and vibrant prints on our official YouTube channel:
    </p>
    <a href="https://www.youtube.com/@nestammakkili" target="_blank" rel="noopener" class="btn small">
      Visit @nestammakkili on YouTube
    </a>
  </div>

  <p style="margin-top:32px;">
    <a class="btn" href="/shop"><%= t('about.cta') %></a>
  </p>
</div>

