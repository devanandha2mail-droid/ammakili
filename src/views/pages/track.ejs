<div class="wrap pg narrow">
  <hr class="rule" style="margin-left:0;">
  <h2><%= t('tracking.title') %></h2>
  <p class="lead" style="max-width:none;"><%= t('tracking.lead') %></p>

  <form method="POST" action="/track" style="margin-top:28px;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form">
      <div class="h">
        <label for="orderId"><%= t('tracking.orderIdLabel') %> *</label>
        <input id="orderId" name="orderId" required placeholder="e.g. NEST-000123" value="<%= typeof orderId !== 'undefined' ? orderId : '' %>">
      </div>
      <div class="h">
        <label for="phone"><%= t('tracking.phoneLabel') %> *</label>
        <input id="phone" name="phone" type="tel" inputmode="numeric" required placeholder="10-digit mobile number" value="<%= typeof phone !== 'undefined' ? phone : '' %>">
      </div>
    </div>
    <div style="margin-top:20px;">
      <button class="btn" type="submit"><%= t('tracking.button') %></button>
    </div>
  </form>

  <% if (searched) { %>
    <div style="margin-top:36px;">
      <% if (order) { %>
        <div class="sum" style="position:static;">
          <h3><%= t('tracking.statusHeading') %>: <span style="color:var(--accent);"><%= order.status.toUpperCase() %></span></h3>
          <div class="r"><span>Order ID</span><span><%= order.orderId %></span></div>
          <div class="r"><span>Placed on</span><span><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span></div>
          <div class="r"><span>Total</span><span>₹<%= order.total.toLocaleString('en-IN') %></span></div>
          
          <% if (order.tracking && order.tracking.courier) { %>
            <div class="r"><span><%= t('tracking.courier') %></span><span><%= order.tracking.courier %></span></div>
          <% } %>
          <% if (order.tracking && order.tracking.trackingId) { %>
            <div class="r"><span><%= t('tracking.trackingId') %></span><span><%= order.tracking.trackingId %></span></div>
          <% } %>

          <div style="margin-top:16px; border-top:1px solid var(--line); padding-top:12px;">
            <strong>Items:</strong>
            <ul style="margin:8px 0 0; padding-left:18px; color:var(--muted);">
              <% order.items.forEach(function(i) { %>
                <li><%= i.name %> (Size: <%= i.size %>) × <%= i.quantity %></li>
              <% }); %>
            </ul>
          </div>
        </div>
      <% } else { %>
        <div style="padding:24px; border-radius:18px; background:var(--glass2); border:1px solid var(--gb); color:var(--c1);">
          <p style="margin:0;"><%= t('tracking.notFound') %></p>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

