<div class="wrap pg">
  <div class="head">
    <hr class="rule">
    <h2><%= t('wishlist.title') %></h2>
    <p class="lead"><%= t('wishlist.lead') %></p>
  </div>

  <div id="wishlist-grid" class="grid">
    <div style="grid-column: 1 / -1; text-align:center; padding:48px 0; color:var(--muted);">
      <p><%= t('wishlist.empty') %></p>
      <a href="/shop" class="btn" style="margin-top:16px;"><%= t('nav.shop') %></a>
    </div>
  </div>
</div>

<script>
(function() {
  var grid = document.getElementById('wishlist-grid');
  var wish = [];
  try {
    wish = JSON.parse(localStorage.getItem('nest_wish') || '[]');
  } catch(e) { wish = []; }

  if (!wish.length) return;

  fetch('/api/wishlist-items?ids=' + encodeURIComponent(wish.join(',')))
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (!data.products || !data.products.length) return;

      var html = '';
      data.products.forEach(function(p) {
        html += '<div class="item">' +
          '<div class="pw">' +
            '<a class="ph" href="/product/' + p.slug + '" aria-label="' + p.name + '">' +
              '<img src="' + p.image + '" alt="' + p.name + '" loading="lazy" width="400" height="500">' +
              (p.tag && p.tag !== 'None' ? '<span class="badge">' + p.tag + '</span>' : '') +
            '</a>' +
            '<button type="button" class="hbtn cardh" data-wish-id="' + p.id + '" data-wish-name="' + p.name + '" aria-label="Remove from wishlist">♥</button>' +
          '</div>' +
          '<div class="meta">' +
            '<h3><a href="/product/' + p.slug + '">' + p.name + '</a></h3>' +
            '<div class="price">₹' + p.price.toLocaleString('en-IN') + '</div>' +
            '<small>' + p.style + '</small>' +
          '</div>' +
        '</div>';
      });

      grid.innerHTML = html;
    })
    .catch(function(err) {
      console.error('Wishlist error:', err);
    });
})();
</script>

