<div class="wrap pg">
  <div class="head">
    <hr class="rule">
    <h2><%= t('wishlist.title') %></h2>
    <p class="lead"><%= t('wishlist.lead') %></p>
  </div>

  <div id="wishlist-grid" class="grid">
    <div style="grid-column: 1 / -1; text-align:center; padding:48px 0; color:var(--muted);">
      <p><%= t('wishlist.empty') %></p>
      <a href="/shop" class="btn" style="margin-top:16px;"><%= t('nav.shop') %></a>
    </div>
  </div>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function() {
  var grid = document.getElementById('wishlist-grid');

  function renderWishlistView() {
    var wishItems = window.WishlistStore ? window.WishlistStore.getItems() : [];
    if (!wishItems.length) {
      grid.innerHTML = '<div style="grid-column: 1 / -1; text-align:center; padding:48px 0; color:var(--muted);">' +
        '<p><%= t('wishlist.empty') %></p>' +
        '<a href="/shop" class="btn" style="margin-top:16px;"><%= t('nav.shop') %></a>' +
        '</div>';
      return;
    }

    window.WishlistStore.validate(function(err, products) {
      if (err || !products || !products.length) {
        grid.innerHTML = '<div style="grid-column: 1 / -1; text-align:center; padding:48px 0; color:var(--muted);">' +
          '<p><%= t('wishlist.empty') %></p>' +
          '<a href="/shop" class="btn" style="margin-top:16px;"><%= t('nav.shop') %></a>' +
          '</div>';
        return;
      }

      var html = '';
      products.forEach(function(p) {
        html += '<div class="item">' +
          '<div class="pw">' +
            '<a class="ph" href="/product/' + p.slug + '" aria-label="' + p.name + '">' +
              '<img src="' + p.image + '" alt="' + p.name + '" loading="lazy" width="400" height="500">' +
              (p.tag && p.tag !== 'None' ? '<span class="badge">' + p.tag + '</span>' : '') +
            '</a>' +
            '<button type="button" class="hbtn cardh" data-wish-id="' + p.id + '" data-wish-name="' + p.name + '" aria-label="Remove from wishlist">♥</button>' +
          '</div>' +
          '<div class="meta">' +
            '<small style="font-variant: all-small-caps; letter-spacing: 0.12em;">' + p.style + '</small>' +
            '<h3><a href="/product/' + p.slug + '">' + p.name + '</a></h3>' +
            '<div class="price">₹' + p.price.toLocaleString('en-IN') + '</div>' +
          '</div>' +
        '</div>';
      });

      grid.innerHTML = html;
    });
  }

  function initWishlist() {
    window.addEventListener('wishlist:updated', renderWishlistView);
    renderWishlistView();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWishlist);
  } else {
    initWishlist();
  }
})();
</script>

