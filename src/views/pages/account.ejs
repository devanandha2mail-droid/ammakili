<div class="wrap pg">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:32px;">
    <div style="display:flex; align-items:center; gap:16px;">
      <% if (customer.avatarUrl) { %>
        <img src="<%= customer.avatarUrl %>" alt="<%= customer.name %>" style="width:64px; height:64px; border-radius:50%; object-fit:cover; border:2px solid var(--gb);">
      <% } else { %>
        <div style="width:64px; height:64px; border-radius:50%; background:var(--c1); color:#fff; display:grid; place-items:center; font-size:1.5rem; font-family:var(--serif);">
          <%= customer.name.charAt(0) %>
        </div>
      <% } %>
      <div>
        <h1 style="font-size:2.2rem; margin:0;"><%= customer.name %></h1>
        <p style="color:var(--muted); margin:2px 0 0; font-size:0.92rem;"><%= customer.email %></p>
      </div>
    </div>

    <form method="POST" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn small ghost">Sign Out</button>
    </form>
  </div>

  <% if (savedMsg) { %>
    <div style="background:#d1fae5; color:#065f46; padding:12px 18px; border-radius:12px; margin-bottom:24px; font-size:0.9rem;">
      ✓ <%= savedMsg %>
    </div>
  <% } %>
  <% if (errorMsg) { %>
    <div style="background:#fee2e2; color:#991b1b; padding:12px 18px; border-radius:12px; margin-bottom:24px; font-size:0.9rem;">
      ⚠️ <%= errorMsg %>
    </div>
  <% } %>

  <!-- Account Navigation Tabs -->
  <div style="display:flex; gap:12px; border-bottom:1px solid var(--line); margin-bottom:28px; overflow-x:auto;">
    <a href="/account?tab=orders" class="tlink" style="margin-left:0; padding:8px 14px; border-bottom:<%= activeTab === 'orders' ? '2px solid var(--accent)' : 'none' %>; font-weight:<%= activeTab === 'orders' ? '500' : '300' %>; color:<%= activeTab === 'orders' ? 'var(--accent)' : 'var(--muted)' %>;">
      My Orders (<%= orders.length %>)
    </a>
    <a href="/account?tab=addresses" class="tlink" style="margin-left:0; padding:8px 14px; border-bottom:<%= activeTab === 'addresses' ? '2px solid var(--accent)' : 'none' %>; font-weight:<%= activeTab === 'addresses' ? '500' : '300' %>; color:<%= activeTab === 'addresses' ? 'var(--accent)' : 'var(--muted)' %>;">
      Saved Addresses (<%= customer.addresses.length %>)
    </a>
    <a href="/account?tab=profile" class="tlink" style="margin-left:0; padding:8px 14px; border-bottom:<%= activeTab === 'profile' ? '2px solid var(--accent)' : 'none' %>; font-weight:<%= activeTab === 'profile' ? '500' : '300' %>; color:<%= activeTab === 'profile' ? 'var(--accent)' : 'var(--muted)' %>;">
      Profile & Settings
    </a>
    <a href="/wishlist" class="tlink" style="margin-left:0; padding:8px 14px; color:var(--muted);">
      Wishlist
    </a>
  </div>

  <!-- TAB 1: ORDERS -->
  <% if (activeTab === 'orders') { %>
    <div>
      <% if (orders.length === 0) { %>
        <div class="narrow" style="text-align:center; padding:48px 20px; margin:0 auto;">
          <p style="color:var(--muted); font-size:1.05rem;">You have not placed any orders yet.</p>
          <a href="/shop" class="btn" style="margin-top:16px;">Explore the Collection</a>
        </div>
      <% } else { %>
        <div style="display:grid; gap:20px;">
          <% orders.forEach(function(o) { %>
            <div class="item" style="border-radius:24px; padding:24px;">
              <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
                <div>
                  <div style="font-family:var(--serif); font-size:1.4rem; color:var(--accent);">
                    <%= o.orderId %>
                  </div>
                  <div style="color:var(--muted); font-size:0.85rem;">
                    Placed on <%= new Date(o.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
                  </div>
                </div>
                <div style="text-align:right;">
                  <span class="badge" style="position:static; transform:none; display:inline-block;">
                    <%= o.status.replace('_', ' ').toUpperCase() %>
                  </span>
                  <div style="font-size:1.15rem; font-weight:500; margin-top:4px;">₹<%= o.total.toLocaleString('en-IN') %></div>
                </div>
              </div>

              <!-- Item snapshots -->
              <div style="border-top:1px solid var(--gb); border-bottom:1px solid var(--gb); padding:12px 0; margin-bottom:14px;">
                <% o.items.forEach(function(item) { %>
                  <div style="display:flex; justify-content:space-between; align-items:center; padding:4px 0; font-size:0.92rem;">
                    <span><%= item.name %> (Size: <strong><%= item.size %></strong>) × <%= item.quantity %></span>
                    <span>₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></span>
                  </div>
                <% }); %>
              </div>

              <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; font-size:0.85rem; color:var(--muted);">
                <div>
                  <% if (o.tracking?.courier) { %>
                    <span>Courier: <strong><%= o.tracking.courier %></strong> (<%= o.tracking.trackingId || 'In transit' %>)</span>
                  <% } else { %>
                    <span>Prepaid via <%= o.payment?.method || 'Razorpay' %></span>
                  <% } %>
                </div>
                <div style="display:flex; gap:10px;">
                  <a href="/checkout/confirmation/<%= o.orderId %>" class="btn small ghost">View Receipt</a>
                  <a href="/track?orderId=<%= o.orderId %>&phone=<%= o.customer.phone %>" class="btn small">Track Status</a>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- TAB 2: SAVED ADDRESSES -->
  <% if (activeTab === 'addresses') { %>
    <div class="two2">
      <!-- Address List -->
      <div>
        <h2 style="font-size:1.4rem; margin-bottom:16px;">Your Addresses</h2>
        <% if (customer.addresses.length === 0) { %>
          <p style="color:var(--muted); padding:20px 0;">No saved addresses. Add your home delivery address below.</p>
        <% } else { %>
          <div style="display:grid; gap:16px;">
            <% customer.addresses.forEach(function(addr) { %>
              <div style="border:1px solid var(--gb); border-radius:18px; padding:20px; background:var(--glass2); position:relative;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                  <strong style="font-size:1.1rem;"><%= addr.label %></strong>
                  <% if (addr.isDefault) { %>
                    <span style="font-size:0.75rem; background:var(--c1); color:#fff; padding:2px 8px; border-radius:999px;">Default</span>
                  <% } else { %>
                    <form method="POST" action="/account/address/default" style="display:inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="addressId" value="<%= addr._id %>">
                      <button type="submit" style="background:none; border:0; color:var(--c2); font-size:0.75rem; cursor:pointer; text-decoration:underline;">Set as Default</button>
                    </form>
                  <% } %>
                </div>

                <p style="margin:10px 0 6px; font-size:0.95rem; line-height:1.5;">
                  <strong><%= addr.name %></strong> (Tel: <%= addr.phone %>)<br>
                  <%= addr.address %><br>
                  <%= addr.city %>, <%= addr.state || 'Kerala' %> - <strong><%= addr.pin %></strong>
                </p>

                <div style="margin-top:12px; text-align:right;">
                  <form method="POST" action="/account/address/delete" onsubmit="return confirm('Remove this address?');" style="display:inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="addressId" value="<%= addr._id %>">
                    <button type="submit" style="background:none; border:0; color:#b91c1c; font-size:0.8rem; cursor:pointer; text-decoration:underline;">Delete</button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Add New Address Form -->
      <div id="cform" style="padding:28px;">
        <h3 style="font-size:1.3rem; margin-bottom:16px;">Add Delivery Address</h3>
        <form method="POST" action="/account/address/add">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="form">
            <div class="f">
              <label for="addr-label">Address Label</label>
              <input id="addr-label" name="label" placeholder="e.g. Home, Parents' House, Office" value="Home">
            </div>

            <div class="h">
              <label for="addr-name">Receiver's Full Name *</label>
              <input id="addr-name" name="name" required value="<%= customer.name %>">
            </div>

            <div class="h">
              <label for="addr-phone">Mobile Number *</label>
              <input id="addr-phone" name="phone" required inputmode="numeric" maxlength="10" value="<%= customer.phone || '' %>" placeholder="10-digit number">
            </div>

            <div class="f">
              <label for="addr-address">Street Address / House Name *</label>
              <textarea id="addr-address" name="address" rows="3" required placeholder="House number/name, street, landmark"></textarea>
            </div>

            <div class="h">
              <label for="addr-city">Town / City *</label>
              <input id="addr-city" name="city" required placeholder="e.g. Kozhikode">
            </div>

            <div class="h">
              <label for="addr-pin">PIN Code *</label>
              <input id="addr-pin" name="pin" required inputmode="numeric" maxlength="6" placeholder="6-digit code">
            </div>
          </div>

          <label class="chk" style="margin-top:16px;">
            <input type="checkbox" name="isDefault" value="true">
            <span>Set as default delivery address</span>
          </label>

          <button type="submit" class="btn" style="margin-top:20px; width:100%;">Save Address</button>
        </form>
      </div>
    </div>
  <% } %>

  <!-- TAB 3: PROFILE & PRIVACY SETTINGS -->
  <% if (activeTab === 'profile') { %>
    <div class="narrow" style="margin:0 auto;">
      <h2 style="font-size:1.4rem; margin-bottom:16px;">Your Profile</h2>

      <div style="background:var(--glass2); border:1px solid var(--gb); border-radius:20px; padding:28px; margin-bottom:32px;">
        <div style="display:grid; gap:14px; font-size:0.95rem; margin-bottom:24px;">
          <div><strong>Signed in via:</strong> Google OAuth 2.0</div>
          <div><strong>Verified Google Email:</strong> <%= customer.email %></div>
          <div><strong>Full Name:</strong> <%= customer.name %></div>
          <div><strong>Member Since:</strong> <%= new Date(customer.createdAt).toLocaleDateString('en-IN') %></div>
        </div>

        <form method="POST" action="/account/profile">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="prof-phone">Contact Phone Number (WhatsApp updates)</label>
          <input id="prof-phone" name="phone" inputmode="numeric" maxlength="10" value="<%= customer.phone || '' %>" placeholder="10-digit mobile number">
          <button type="submit" class="btn small" style="margin-top:14px;">Save Contact Number</button>
        </form>
      </div>

      <!-- Account Deletion -->
      <div style="border:1px solid #fee2e2; background:rgba(254, 226, 226, 0.4); border-radius:20px; padding:28px;">
        <h3 style="font-size:1.2rem; color:#991b1b; margin-bottom:8px;">Delete Account</h3>
        <p style="color:var(--muted); font-size:0.88rem; line-height:1.5; margin-bottom:18px;">
          Permanently delete your profile, saved addresses, and synced wishlist. Previous orders will be kept securely for statutory taxation and fulfillment records, but will be detached from your identity and your Google ID will be purged.
        </p>

        <form method="POST" action="/account/delete" onsubmit="return confirm('Are you sure you want to permanently delete your customer account? This cannot be undone.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn small" style="background:#b91c1c; border-color:#b91c1c; color:#fff;">
            Delete My Account
          </button>
        </form>
      </div>
    </div>
  <% } %>
</div>

