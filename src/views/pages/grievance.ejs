<div class="wrap pg narrow">
  <%- include('../partials/legal-template-warning') %>

  <hr class="rule" style="margin-left:0;">
  <h2><%= t('grievance.title') %></h2>
  <p class="lead" style="max-width:none;"><%= t('grievance.lead') %></p>

  <div style="margin-top:28px; display:flex; flex-direction:column; gap:20px;">
    <div class="item" style="padding:24px; border-radius:18px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.2rem; margin:0 0 10px; color:var(--ink); font-weight:600;"><%= t('grievance.officerTitle') %></h3>
      <p style="margin:0 0 14px; font-size:0.92rem; color:var(--muted); line-height:1.6;"><%= t('grievance.officerText') %></p>
      
      <div style="background:var(--bg); padding:16px 20px; border-radius:12px; border:1px solid var(--border); font-size:0.9rem; line-height:1.8;">
        <div><strong>Name:</strong> <%= settings.grievanceOfficer?.name || 'Devanandha K. M.' %></div>
        <div><strong>Designation:</strong> <%= settings.grievanceOfficer?.designation || 'Grievance Redressal Officer' %></div>
        <div><strong>Official Email:</strong> <a href="mailto:<%= settings.grievanceOfficer?.email || settings.contactEmail || 'grievance@nestammakkili.com' %>" style="color:var(--primary); text-decoration:underline;"><%= settings.grievanceOfficer?.email || settings.contactEmail || 'grievance@nestammakkili.com' %></a></div>
        <div><strong>Direct Contact Phone:</strong> <%= settings.grievanceOfficer?.phone || settings.contactPhone || '+91 98460 12345' %></div>
        <div><strong>Office Address:</strong> <%= settings.registeredAddress || 'Building 4B, Palace Road, Thrissur, Kerala - 680001, India' %></div>
        <div><strong>Support Hours:</strong> <%= settings.businessHours || 'Monday to Saturday, 9:00 AM – 6:00 PM IST' %></div>
      </div>
    </div>

    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('grievance.processTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;"><%= t('grievance.processText') %></p>
    </div>

    <div class="item" style="padding:20px; border-radius:16px; background:var(--glass2); border:1px solid var(--gb);">
      <h3 style="font-size:1.15rem; margin:0 0 8px; color:var(--ink); font-weight:600;"><%= t('grievance.filingTitle') %></h3>
      <p style="margin:0; font-size:0.92rem; color:var(--muted); line-height:1.6;"><%= t('grievance.filingText') %></p>
    </div>
  </div>

  <%- include('../partials/legal-contact-card') %>
</div>

