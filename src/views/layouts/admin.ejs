<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Admin' %> – Nest by Ammakkili Admin</title>
  <!-- Self-hosted Fonts -->
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="icon" href="/img/brand/logo-full-128.png">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="stylesheet" href="/css/admin-dark.css">
</head>
<body class="admin">
  <header>
    <a href="/admin" style="display:flex; align-items:center; gap:14px; text-decoration:none;">
      <img src="/img/brand/logo-full-128.png" srcset="/img/brand/logo-full-128.png 1x, /img/brand/logo-full-256.png 2x" width="48" height="48" alt="Nest logo">
      <div>
        <div style="font-family:var(--a-serif); font-size:1.35rem; font-style:italic; color:var(--a-ink); line-height:1;">Nest by Ammakkili</div>
        <span class="a-tag" style="margin-top:2px;">Admin Panel</span>
      </div>
    </a>

    <nav aria-label="Admin Navigation">
      <a href="/admin" <%= (typeof path !== 'undefined' && path === '/admin') ? 'aria-current="page"' : '' %>>Dashboard</a>
      <a href="/admin/products" <%= (typeof path !== 'undefined' && path.startsWith('/admin/products')) ? 'aria-current="page"' : '' %>>Products</a>
      <a href="/admin/orders" <%= (typeof path !== 'undefined' && path.startsWith('/admin/orders')) ? 'aria-current="page"' : '' %>>Orders</a>
      <a href="/admin/customers" <%= (typeof path !== 'undefined' && path.startsWith('/admin/customers')) ? 'aria-current="page"' : '' %>>Customers</a>
      <a href="/admin/banners" <%= (typeof path !== 'undefined' && path.startsWith('/admin/banners')) ? 'aria-current="page"' : '' %>>Banners</a>
      <a href="/admin/settings" <%= (typeof path !== 'undefined' && path.startsWith('/admin/settings')) ? 'aria-current="page"' : '' %>>Settings</a>
      <a href="/admin/diagnostics" <%= (typeof path !== 'undefined' && path.startsWith('/admin/diagnostics')) ? 'aria-current="page"' : '' %>>Diagnostics</a>
      <a href="/" target="_blank" rel="noopener" style="opacity:0.75;">View Shop ↗</a>
      <a href="/admin/logout" style="color:var(--a-bad);">Logout</a>
    </nav>
  </header>

  <main class="a-wrap">
    <%- body %>
  </main>
</body>
</html>
