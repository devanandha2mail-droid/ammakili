<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    (function () {
      try {
        var t = localStorage.getItem('nest_theme');
        if (!t) {
          t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title + ' – Nest by Ammakkili' : 'Nest by Ammakkili – Nightwear, softly considered' %></title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : t('site.description') %>">
  
  <!-- Canonical & Open Graph -->
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : ((typeof siteUrl !== 'undefined' ? siteUrl : '') + path) %>">
  <meta property="og:site_name" content="Nest by Ammakkili">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Nest by Ammakkili' %>">
  <meta property="og:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : t('site.description') %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <% 
    const baseDomain = typeof siteUrl !== 'undefined' ? siteUrl : '';
    const defaultOg = baseDomain + '/img/brand/og-image-1200x630.png';
    const resolvedOg = typeof ogImage !== 'undefined' ? ogImage : defaultOg;
  %>
  <meta property="og:image" content="<%= resolvedOg %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Nest by Ammakkili' %>">
  <meta name="twitter:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : t('site.description') %>">
  <meta name="twitter:image" content="<%= resolvedOg %>">

  <!-- Favicon & Device Icons -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/brand/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/brand/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/brand/apple-touch-icon-180.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Organization JSON-LD -->
  <script type="application/ld+json" nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Nest by Ammakkili",
    "url": "http://localhost:3000",
    "logo": "http://localhost:3000/img/brand/logo-full-512.png",
    "description": "Online shop for women's nighties.",
    "sameAs": [
      "https://www.youtube.com/@nestammakkili"
    ]
  }
  </script>

  <!-- Self-hosted Fonts: Cormorant Garamond, Jost, Noto Sans Malayalam, Noto Serif Malayalam -->
  <link rel="stylesheet" href="/css/fonts.css">

  <link rel="stylesheet" href="/css/glass.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <meta name="theme-color" content="#892245">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <!-- Dynamic floating ambient glass elements -->
  <div class="bg" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="glow" aria-hidden="true"></div>

  <!-- Header -->
  <%- include('../partials/header') %>

  <!-- Main Content -->
  <main id="top" tabindex="-1">
    <%- body %>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Toast notification banner -->
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <!-- Scripts -->
  <script src="/js/header.js" defer></script>
  <script src="/js/main.js" defer></script>
  <script src="/js/cart-store.js" defer></script>
  <script src="/js/cart-page.js" defer></script>
  <script src="/js/wishlist-store.js" defer></script>
  <script src="/js/product-card.js" defer></script>
  <% if (typeof script !== 'undefined') { %>
    <%- script %>
  <% } %>
</body>
</html>

